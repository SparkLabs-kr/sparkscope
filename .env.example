# =====================================================================
# SparkScope 환경 변수 — 템플릿
#
# 쓰는 법
#   1) Vercel에서 한 번에 내려받는다 (대부분의 값이 여기 있다)
#        npm i -g vercel && vercel login && vercel link
#        vercel env pull .env.local
#   2) 내려받은 뒤 아래 [로컬에서 직접 넣어야 하는 것]을 손으로 추가한다.
#   3) 빠진 키가 없는지 대조한다 — 출력이 비면 완료:
#        comm -13 <(grep -oE '^[A-Z_0-9]+' .env.local | sort) \
#                 <(grep -oE '^[A-Z_0-9]+' .env.example | sort)
#
# ⚠️ 이 파일에는 실제 값을 절대 적지 않는다. 키 이름과 "어디서 받는지"만 적는다.
#    .env.local 은 .gitignore(.env*)에 걸려 있어 git으로는 영원히 전달되지 않는다.
#    GitHub Secrets 도 Actions 안에서만 읽히므로 로컬로 내려오지 않는다.
#
# 2026-10-08 전면 갱신 — 그 전까지 이 파일은 코드와 어긋나 있었다.
#   · DATABASE_URL(SQLite)로 적혀 있었지만 schema.prisma 는 POSTGRES_PRISMA_URL 을 본다
#     → 예제대로 채우면 DB에 아예 못 붙었다.
#   · GOOGLE_CLIENT_ID / DEV_AUTH_BYPASS 가 없어서, 성실히 채워도 로그인 화면에서
#     "지금은 로그인할 수 없습니다"에 막혔다(auth.ts GOOGLE_ENABLED).
# =====================================================================


# =====================================================================
# 1. 필수 — 이게 없으면 화면이 아예 안 뜬다
# =====================================================================

# --- 데이터베이스 (Supabase Postgres) ---
# prisma/schema.prisma 의 datasource 가 이 두 개를 본다. DATABASE_URL 이 아니다.
#   url       = env("POSTGRES_PRISMA_URL")        ← 커넥션 풀 경유
#   directUrl = env("POSTGRES_URL_NON_POOLING")   ← 마이그레이션용 직결
# 출처: Vercel 환경변수(vercel env pull) 또는 Supabase > Project Settings > Database
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- OpenAI ---
# 기사 분류·심층분석·요약·번역 전반. 코드 30여 곳에서 쓴다.
# 출처: platform.openai.com
OPENAI_API_KEY=

# --- NextAuth ---
# NEXTAUTH_URL 은 "실제로 서버가 뜬 주소"와 정확히 같아야 한다.
# vercel env pull 은 여기에 프로덕션 주소를 덮어쓰므로, 로컬에서는 반드시 되돌린다.
# 포트가 3000이 아니면(이미 쓰는 중이면 Next가 3001로 올라간다) 그 포트를 적는다.
NEXTAUTH_URL="http://localhost:3000"
# 생성: openssl rand -base64 32
NEXTAUTH_SECRET=


# =====================================================================
# 2. 로컬에서 직접 넣어야 하는 것 — Vercel에서 내려오지 않는다
#    (오히려 Vercel에 올리면 안 되는 것도 있다)
# =====================================================================

# --- 로그인 우회 (로컬 전용) ---
# true면 매직링크·구글 로그인 없이 /dashboard 가 바로 열린다.
# 구글 키 없이 로컬에서 화면을 보는 정상 경로이고, 팀 전원이 이 방식으로 작업한다.
#
# ⚠️ Vercel 환경변수에는 절대 넣지 않는다.
#    2026-09-08, Vercel에 이 값이 남아 있어 코드에서 상수를 false로 바꿔 배포했는데도
#    프로덕션 /dashboard 가 로그인 없이 열렸다. 게다가 Vercel은 민감값으로 저장된 것을
#    다시 보여주지 않아 켜져 있는지조차 확인할 수 없었다.
#    지금은 flags.ts 가 NODE_ENV=production 이면 무시하게 이중으로 막혀 있지만,
#    애초에 올리지 않는 것이 맞다.
DEV_AUTH_BYPASS="true"

# 우회로 들어갈 때 흉내낼 등급 — ADMIN(기본) | STAFF | PORTFOLIO
# 등급마다 화면이 다르므로, 포트폴리오사 공개 화면을 확인하려면 PORTFOLIO 로 바꾼다.
DEV_AUTH_ROLE=
# PORTFOLIO 로 볼 때 어느 회사로 볼지 — MonitoringTarget.id
DEV_AUTH_COMPANY_ID=
# 우회 시 사용할 이메일(비우면 기본값)
DEV_AUTH_EMAIL=

# --- 구글 서비스 계정 키 파일 ---
# 브리핑 영상 TTS(briefing-video/tts.ts)와 시트 연동이 쓴다.
# 값이 아니라 "파일 경로"라서 vercel env pull 로도 내려오지 않는다.
# 파일 자체는 .gitignore 에 걸려 있다 — Google Cloud 콘솔에서 본인 이름으로
# 새 서비스 계정 키를 발급받아 저장소 루트에 둔다. 채팅·메일로 주고받지 않는다.
GOOGLE_APPLICATION_CREDENTIALS="./google-service-account.json"


# =====================================================================
# 3. 로그인 (구글 OAuth)
#    로컬에서는 보통 비워 둔다 — 위 DEV_AUTH_BYPASS 로 충분하다.
#    둘 다 채워야 로그인 버튼이 나타난다(auth.ts GOOGLE_ENABLED).
#    한쪽만 채우면 버튼이 안 보이고 "지금은 로그인할 수 없습니다"가 뜬다.
#    로컬에서 실제로 구글 로그인을 쓰려면 Google Cloud 콘솔의 승인된 리디렉션 URI에
#    http://localhost:<포트>/api/auth/callback/google 을 등록해야 한다.
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 사내 계정으로 인정할 이메일 도메인(쉼표 구분). 기본 sparklabs.co.kr
# (옛 이름 ALLOWED_EMAIL_DOMAIN(단수)도 roles.ts 가 아직 받아주지만, 새로 넣을 땐 복수형을 쓴다)
ALLOWED_EMAIL_DOMAINS=
# 관리 화면(키워드·노이즈·검수·계정발급) 권한자 이메일(쉼표 구분).
# 비우면 marketing@sparklabs.co.kr,sparkai@sparklabs.co.kr 로 동작한다(roles.ts).
ADMIN_EMAILS=


# =====================================================================
# 4. 다이제스트 메일 발송
# =====================================================================

# Resend — resend.com 에서 발급
RESEND_API_KEY=
# 발신 주소 (도메인 인증된 주소만 가능)
DIGEST_FROM_EMAIL="sparkscope@sparklabs.co.kr"
# 수신 그룹
DIGEST_TO_GROUP="all@sparklabs.co.kr"
# 숨은참조
DIGEST_BCC=
# 메일 안 링크의 기준 주소(기본 https://sparkscope.vercel.app)
DIGEST_BASE_URL=
# 시범 운영 중 본인에게만 보낼 때
DIGEST_TEST_RECIPIENT=

# 구독자별 발송 스위치.
# true면 DigestSubscriber 표를 보고 사람마다 고른 섹션만 담아 1인 1통씩 보낸다.
# 비어 있거나 false면 위 DIGEST_TO_GROUP 으로 1통 보낸다.
# ⚠️ 반드시 scripts/seed-subscribers.ts 로 명단을 넣고 인원수를 확인한 뒤에 켤 것 —
#    명단이 비거나 일부만 들어간 상태에서 켜면 나머지 전원이 조용히 메일을 못 받는다.
DIGEST_USE_SUBSCRIBERS="false"

# 수집 실패 등 장애 알림을 받을 주소(runner.ts)
ADMIN_ALERT_EMAIL=


# =====================================================================
# 5. 브리핑 영상 · 크론
# =====================================================================

# Vercel Cron 보안 — 외부에서 cron URL을 함부로 호출하지 못하게. 32자 이상 랜덤 문자열
CRON_SECRET=

# Vercel 크론이 GitHub Actions 워크플로를 제시각에 시작시키는 데 쓴다
# (GitHub schedule 은 2~3시간씩 늦게 뜬다. CLAUDE.md 크론 구조 참고).
# 이 저장소 Actions 쓰기 권한 fine-grained 토큰 — 이수 관리.
# 없으면 수집이 늦게 끝나 그날 메일에 당일 기사가 빠진다.
GITHUB_DISPATCH_TOKEN=

# 잔디 웹훅 — 브리핑 영상 전송
JANDI_WEBHOOK_URL=
# 위클리(월요일) 전용 방. 비우면 위 데일리 방으로 간다.
JANDI_WEBHOOK_URL_WEEKLY=


# =====================================================================
# 6. Supabase · 파트너 공개 API
# =====================================================================

# 브라우저에도 노출되는 공개 값(NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서비스 롤 키 — 브리핑 영상 업로드(publish.ts)에 쓴다.
# ⚠️ RLS를 전부 우회하는 키다. 브라우저로 나가는 코드에 절대 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 파트너(블루사이트)가 /api/partner/signals 를 부를 때 쓰는 키
PARTNER_API_KEY=

# 스크랩 기능을 허용할 이메일(쉼표 구분)
SCRAP_ALLOWED_EMAILS=


# =====================================================================
# 7. 외부 데이터 소스 (옵션 — 비워도 화면은 정상 동작한다)
# =====================================================================

# 구글 시트에서 매체 목록 동기화 (sync-media-sheet)
GOOGLE_SHEETS_API_KEY=

# OpenRouter — 일부 모델 호출 경로
OPENROUTER_API_KEY=

# 펀드 현황 표 데이터 출처. 비우면 펀드 패널이 그려지지 않는다(fund-db.ts)
FUND_DB_URL=

# 네이버 뉴스 검색 — developers.naver.com. 비우면 구글 뉴스 RSS만 쓴다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 소셜 시그널 (Inter 탭) ──
# Hacker News 는 무인증으로 동작한다(설정 불필요).
# Reddit: 없으면 RSS로 최신순만 나온다. 앱 등록은 무료 — 넣으면 인기순으로 승격.
#   https://www.reddit.com/prefs/apps 에서 "script" 타입으로 생성
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X: 유료 API(Basic $200/월). 비워두면 X 패널은 "연결 필요" 상태로 남는다.
X_BEARER_TOKEN=
# Threads: OAuth + 앱 심사가 필요하다. 미발급 상태.
THREADS_ACCESS_TOKEN=


# =====================================================================
# 참고 — 여기에 적지 않는 것
#
# · APPLY / FORCE / LIMIT / WINDOW_DAYS / CLEANUP_APPLY / COLLECT_DAYS_BACK 등은
#   .env 에 넣는 설정이 아니라 스크립트를 돌릴 때 앞에 붙이는 일회용 플래그다.
#     예) APPLY=1 npx tsx --env-file=.env.local scripts/....ts
#
# · ANTHROPIC_API_KEY 는 뺐다. 2026년 10월 방침으로 프로덕션에서 Claude 를 제외했다.
#   competitor-insights.ts 등 남은 사용처는 마이그레이션 대상이다.
#
# · DATABASE_URL 도 뺐다. 위 POSTGRES_PRISMA_URL 로 대체됐고, 남겨두면 "채웠는데
#   DB에 안 붙는" 상태를 다시 만든다.
# =====================================================================
