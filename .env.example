# =====================================================================
# SparkScope 환경 변수
# 이 파일을 .env.local로 복사한 뒤 실제 값으로 채우세요.
# =====================================================================

# --- 데이터베이스 ---
# 개발: SQLite (별도 서비스 가입 불필요)
# 프로덕션: Vercel Postgres 권장
# 예시: postgres://user:password@host/db?sslmode=require
DATABASE_URL="file:./prisma/dev.db"

# --- Anthropic Claude API ---
# console.anthropic.com 에서 발급 (analyzer.ts 외 스크립트에서 아직 사용 중)
ANTHROPIC_API_KEY="sk-ant-..."

# --- OpenAI API ---
# platform.openai.com 에서 발급. analyzer.ts의 기사 분류/심층분석/편집자 인사말에 사용
OPENAI_API_KEY="sk-proj-..."

# --- Resend (메일 발송) ---
# resend.com 에서 발급. 무료 티어 월 3,000건
RESEND_API_KEY="re_..."

# 발신 이메일 (도메인 인증된 주소만 사용 가능)
DIGEST_FROM_EMAIL="sparkscope@sparklabs.co.kr"

# 수신 그룹
DIGEST_TO_GROUP="all@sparklabs.co.kr"

# 시범 운영 중 본인에게만 보내려면 이메일 직접 입력
DIGEST_TEST_RECIPIENT="mido.jang@gmail.com"

# --- Vercel Cron 보안 ---
# 임의의 32자 이상 랜덤 문자열. 외부에서 cron URL을 함부로 호출하지 못하게
CRON_SECRET="change-this-to-a-random-32-char-string-please"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# `openssl rand -base64 32` 로 생성
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# --- 도메인 인증 ---
# 이 도메인들의 이메일은 사내 계정(role=ADMIN)으로 자동 생성된다.
# 한국뿐 아니라 대만·호주 등 각 오피스 도메인을 쉼표로 구분해 모두 넣는다.
# 그 밖의 외부 메일은 관리자가 /dashboard/accounts 에서 발급해둔 경우에만 로그인된다.
#
# ⚠️ 여기 넣은 도메인의 메일 주소를 가진 사람은 누구나 관리자가 된다.
#    회사가 실제로 통제하는 도메인만 넣을 것. gmail.com 같은 공용 도메인 금지.
ALLOWED_EMAIL_DOMAINS="sparklabs.co.kr"
# (구버전 단수형도 계속 읽는다. 위 값이 있으면 아래는 무시된다.)
# ALLOWED_EMAIL_DOMAIN="sparklabs.co.kr"

# --- 스크랩·발송 권한 (내부 계정 중에서도 지정 계정만) ---
# 쉼표 구분. 비워두면 스크랩·노이즈 처리·다이제스트 발송이 아무에게도 열리지 않는다.
# (대시보드·키워드 관리 접근과는 별개 — 그쪽은 role=ADMIN 이면 된다.)
SCRAP_ALLOWED_EMAILS=""

# --- (로컬 전용) 로그인 우회 ---
# true 면 매직 링크 없이 관리자 권한으로 화면이 열린다. 배포 환경에는 절대 넣지 않는다.
DEV_AUTH_BYPASS="false"
# 우회 모드에서 쓸 가짜 관리자 메일 (사내 도메인이어야 ADMIN으로 취급)
DEV_AUTH_EMAIL="dev@sparklabs.co.kr"

# --- (옵션) 네이버 뉴스 검색 API ---
# developers.naver.com 에서 발급. 비워두면 Google News RSS만 사용
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ── 소셜 시그널 (Inter 탭) ──────────────────────────────
# Hacker News는 무인증으로 동작한다(설정 불필요).
# Reddit: 없으면 RSS로 최신순만 나온다. 앱 등록은 무료 — 넣으면 인기순으로 승격.
#   https://www.reddit.com/prefs/apps 에서 "script" 타입으로 생성
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X: 유료 API(Basic $200/월). 비워두면 X 패널은 "연결 필요" 상태로 남는다.
X_BEARER_TOKEN=
