// SparkScope DB 스키마
// 개발: SQLite, 프로덕션: Postgres (Vercel Postgres)
// provider만 바꾸면 둘 다 호환

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ===== NextAuth =====
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ===== SparkScope 핵심 =====
model MonitoringTarget {
  id              String   @id @default(cuid())
  name            String   @unique
  englishName     String?
  category        String   // sparklabs_self / portfolio_company / industry_trend / executive / competitor
  status          String   @default("ACTIVE") // ACTIVE / PAUSED / EXIT
  primaryKeyword  String
  helperKeywords  String?  // 쉼표 구분, 동음이의어 대응 (e.g. "PlayKeyboard, 비트바이트앱")
  excludeWords    String?  // 쉼표 구분, 노이즈 차단
  contextWords    String?  // 쉼표 구분, 문맥어 — 지정 시 제목에 하나라도 포함돼야 통과 (예: "교통안전, AI, 스마트교통")
  portfolioStatus String?  // 포트폴리오 CSV 원본 상태값 (Live/Exit/Written-off) — status(ACTIVE)와 별개, 표시용 라벨
  tier            String?  // 포트폴리오 CSV 원본 티어 (A/B/C)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([category, status])
}

model Article {
  id                String   @id @default(cuid())
  title             String
  link              String   @unique
  source            String
  pubDate           DateTime
  matchedKeyword    String
  category          String   // sparklabs_self / portfolio_company / industry_trend / etc
  // 분석 결과
  importance        String?  // CRITICAL / HIGH / MEDIUM / LOW
  tone              String?  // POSITIVE / NEUTRAL / NEGATIVE / MIXED
  oneLiner          String?
  ourTake           String?  // 본부 관점 한 줄
  relatedCompanies  String?  // JSON 배열
  pitchScore        Int?     // 0-100, 기획기사 피칭 기회 점수
  pitchTopic        String?
  // 영어 화면(EN)용 번역 캐시 — 화면에 뜰 때 채우고 재사용한다.
  // 채우는 쪽은 lib/sparkscope/translate-content.ts, 전체 백필은 scripts/backfill-title-en.ts.
  titleEn           String?
  oneLinerEn        String?
  pitchTopicEn      String?
  riskFlag          String?
  isNoise           Boolean  @default(false)
  noiseReason       String?
  priorityScore     Int      @default(0)
  // 스크랩 (본부 큐레이션)
  isScrapped        Boolean  @default(false)
  scrappedAt        DateTime?
  scrappedBy        String?
  // 메타
  collectedAt       DateTime @default(now())
  analyzedAt        DateTime?
  @@index([pubDate])
  @@index([category, importance])
  @@index([matchedKeyword])
  @@index([isScrapped])
}

// 기사 임베딩 — 챗봇의 의미 검색용.
//
// Article과 분리한 이유: pgvector 타입을 Prisma가 다루지 못해(Unsupported) 조회는
// 전부 raw SQL이다. 본문 테이블에 섞으면 일반 조회까지 지저분해진다.
// 실제 컬럼 생성은 scripts/enable-vector.ts가 raw SQL로 한다(db push를 쓰지 않는다).
// 여기 적어두는 건 나중에 db push가 이 테이블을 모르는 채로 지워버리지 않게 하려는 것.
model ArticleEmbedding {
  articleId String   @id
  // text-embedding-3-small을 512차원으로 줄여서 쓴다.
  // 1536차원이면 30만 건 기준 저장·인덱스가 3배로 커지는데 이 용도에선 체감 차이가 없다.
  embedding Unsupported("vector(512)")
  model     String
  updatedAt DateTime @default(now())
}

// 개인 북마크 — 로그인한 사용자 각자의 북마크 목록. ★ 스크랩(본부 큐레이션·다이제스트용)과 별개로,
// 누구나 자기 것만 보인다. Article과는 FK 없이 articleId로만 연결(다른 테이블들과 동일한 패턴).
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  @@unique([userId, articleId])
  @@index([userId])
}

// 노이즈 신고 시 AI가 제안하는 문맥어/제외어 추가 — 바로 적용되지 않고 관리자 승인 대기.
// 신고 1건만 보고 자동 적용하면 과적합(그 기사 하나 막으려다 진짜 관련기사까지 막는) 위험이
// 있어서(2026-08 946건 소급판정 사고에서 배운 교훈), 사람이 한 번 보고 승인해야 반영된다.
model NoiseSuggestion {
  id             String   @id @default(cuid())
  articleId      String
  targetName     String   // MonitoringTarget.name
  field          String   // 'excludeWords' | 'contextWords'
  currentValue   String?  // 제안 당시 기존 값(승인 시 이 값 기준으로 이어붙임 — 그 사이 바뀌었으면 감지용)
  addition       String   // 추가로 제안하는 문구만(전체 값 아님)
  reason         String   // AI가 이렇게 제안한 이유
  status         String   @default("PENDING") // PENDING / APPROVED / REJECTED
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  @@index([status])
  @@index([articleId])
}

// 일반 사용자의 노이즈 신고 요청 — 관리자의 즉시 처리(NoiseReportButton/api/noise-report)와 달리
// 승인 전까지는 Article.isNoise를 건드리지 않는다. 관리자가 승인하면 그제서야 관리자가 직접
// 신고한 것과 동일하게 처리(Article.isNoise=true + AI 재발방지 제안 생성)되고, 거절되면 아무 것도
// 바뀌지 않는다(신고 자체만 REJECTED로 기록).
model NoiseReportRequest {
  id         String    @id @default(cuid())
  articleId  String
  reportedBy String    // 신고자 이메일
  reason     String    // 신고 사유 (필수 입력)
  status     String    @default("PENDING") // PENDING / APPROVED / REJECTED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  @@index([status])
  @@index([articleId])
}

model Digest {
  id          String   @id @default(cuid())
  date        DateTime @unique
  subject     String
  htmlBody    String
  recipients  Int      @default(0)
  sentAt      DateTime?
  errorMsg    String?
  createdAt   DateTime @default(now())
}

model RunLog {
  id          String   @id @default(cuid())
  runType     String   // daily / manual / test / dashboard-insights
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  status      String   // RUNNING / SUCCESS / FAILED
  collected   Int      @default(0)
  analyzed    Int      @default(0)
  errors      String?
}

// 대시보드 AI 요약 사전계산 결과 — 위기 원인 / 경쟁사 트렌드.
// daily-collect 크론 끝에서 하루 1회 계산해 저장하고, 대시보드는 읽기만 한다
// (렌더링 시점에 LLM을 호출하지 않아 탭 클릭이 항상 빠르게 반응하도록).
model DashboardInsight {
  id         String   @id @default(cuid())
  kind       String   // crisis_cause / competitor_trend / competitor_overall
  key        String   // crisis_cause·competitor_trend: 회사명 / competitor_overall: "overall" 고정값
  value      String   // JSON — {"cause":"..."} / {"points":[...]} / {"lines":[...]}
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([kind, key])
  @@index([kind])
}

// ===== Inter(해외 트렌드) 탭 =====
model InterNews {
  id        String   @id @default(cuid())
  source    String   // TechCrunch, Ars Technica, Wired, MIT Tech Review
  title     String
  url       String   @unique
  publishedAt DateTime
  rawText   String?  // 기사 본문 (선택, 나중에 포트폴리오 매칭에서 쓸 수 있음)
  collectedAt DateTime @default(now())
  verdicts  InterNewsVerdict[]
  @@index([collectedAt])
  @@index([source])
}

model InterNewsVerdict {
  id        String   @id @default(cuid())
  newsId    String
  news      InterNews @relation(fields: [newsId], references: [id], onDelete: Cascade)
  relevant  Boolean
  reason    String   // "AI 인프라 트렌드", "노이즈: 쿠폰 행사" 등
  domain    String?  // 'bio' | 'ai' — relevant=true인 기사만 채워짐
  sector    String?  // [레거시] inter-taxonomy.ts BIO_TREND_SECTORS/AI_TREND_SECTORS의 key. 축이 섞여 있어(주제+사건유형) 아래 두 컬럼으로 분리됨. 되돌리기용으로 보존.
  // 축 분리 (2026-08-04) — sector 하나에 주제와 사건유형이 섞여 있어서 "머크가 항암 신약사 인수"가
  // 항암이 아니라 투자·산업동향으로 분류되고, 그 카테고리 혼자 relevant 450건 중 151건(34%)을 먹고 있었다.
  topicSector String?  // 무엇에 관한 기사인가 — BIO_TOPIC_SECTORS/AI_TOPIC_SECTORS의 key
  eventType   String?  // 무슨 일이 일어났는가 — INTER_EVENT_TYPES의 key (투자·딜/규제·승인/연구성과/제품·상용화/시장·인물)
  country   String?  // 'us' | 'cn' | 'jp' | 'sa' | 'other' — 기사가 다루는 트렌드의 주요 국가(매체 소속 국가 아님). relevant=true만 채워짐
  titleKo   String?  // 제목 한국어 번역
  reasonEn  String?  // EN 화면용 판정 사유 번역 캐시 (translate-content.ts가 채운다)
  model     String   @default("gemini-3.1-flash-lite") // 판정한 모델
  filteredAt DateTime @default(now())
  // 스크랩 (Inter 탭) — Article.isScrapped와 같은 패턴. 스크랩 단위를 InterNews가 아닌
  // verdict로 두는 이유: 화면에 보이는 건 판정 결과(한국어 제목·도메인·섹터)이고,
  // 스크랩함에서도 그 정보를 그대로 보여줘야 한다.
  isScrapped Boolean  @default(false)
  scrappedAt DateTime?
  scrappedBy String?
  matches   InterPortfolioMatch[]
  @@unique([newsId, model])
  @@index([filteredAt])
  @@index([relevant])
  @@index([domain])
  @@index([sector])
  @@index([isScrapped])
  @@index([topicSector])
  @@index([eventType])
}

model InterPortfolioMatch {
  id              String   @id @default(cuid())
  verdictId       String
  verdict         InterNewsVerdict @relation(fields: [verdictId], references: [id], onDelete: Cascade)
  companyName     String   // 포트폴리오 회사명
  reason          String   // "생성형 AI 투자 발표", "CEO 인용" 등
  reasonEn        String?  // EN 화면용 매칭 사유 번역 캐시
  model           String   @default("gpt-5.4-mini")
  matchedAt       DateTime @default(now())
  @@unique([verdictId, companyName, model])
  @@index([matchedAt])
  @@index([companyName])
}
